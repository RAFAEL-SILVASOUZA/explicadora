DATABASE_URL=postgres://estudo:estudo@localhost:5403/estudo
JWT_SECRET=troque-por-um-segredo-de-32-caracteres
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_SENHA=troque-por-uma-senha-forte
# Servidor local compatível com a API OpenAI (LM Studio / llama.cpp / Ollama).
# Para LLM local a chave não é validada: qualquer valor serve, ex. "dummy".
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen3.8-flash-next-iq2_xs
LLM_API_KEY=dummy
# TTS local (Piper). Binário e modelo pt-BR. Sem essas duas variáveis o dever é
# criado sem áudio e a tela da criança usa legendas + duração estimada.
# Modelo recomendado: pt_BR-faber-medium (CPU, ~60 MB).
PIPER_BIN=/caminho/para/piper
PIPER_MODEL=/caminho/para/pt_BR-faber-medium.onnx
